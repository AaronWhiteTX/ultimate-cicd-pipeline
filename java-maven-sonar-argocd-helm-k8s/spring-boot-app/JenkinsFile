pipeline {
  agent {
    docker {
      image 'maven:3.9.6-eclipse-temurin-17'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock --memory=4g'
    }
  }

  stages {
    stage('Setup Docker CLI and Git') {
      steps {
        sh '''
          apt-get update && apt-get install -y docker.io git
          git --version
          docker --version
        '''
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
        sh '''
          echo "=== DEBUG: Checkout Info ==="
          echo "WORKSPACE: ${WORKSPACE}"
          pwd
          ls -la
          echo "Current branch:"
          git branch --show-current || echo "Could not get branch"
          echo "Git status:"
          git status
          echo "=== END DEBUG ==="
        '''
      }
    }

    stage('Build and Test') {
      steps {
        sh '''
          cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
          mvn clean package
        '''
      }
    }

    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://54.205.168.78:9000"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh '''
            cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.11.0.3922:sonar \
              -Dsonar.token=$SONAR_AUTH_TOKEN \
              -Dsonar.host.url=$SONAR_URL \
              -Dsonar.projectKey=UltimateCICD \
              -Dsonar.projectName=UltimateCICD
          '''
        }
      }
    }

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "aaront93/ultimate-cicd:${BUILD_NUMBER}"
      }
      steps {
        script {
          sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
          def dockerImage = docker.image("${DOCKER_IMAGE}")
          docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
            dockerImage.push()
          }
        }
      }
    }

    stage('Update Deployment File') {
      environment {
        GIT_REPO_NAME = "ultimate-cicd-pipeline"
        GIT_USER_NAME = "AaronWhiteTX"
      }
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            echo "=== DEBUG: Before Git Operations ==="
            echo "Current directory:"
            pwd
            echo "WORKSPACE variable: ${WORKSPACE}"
            echo "Listing current directory:"
            ls -la
            echo "=== END DEBUG ==="
            
            # Navigate to workspace root
            cd ${WORKSPACE}
            
            echo "=== DEBUG: After cd to WORKSPACE ==="
            pwd
            ls -la
            echo "Checking for .git directory:"
            ls -la .git || echo ".git not found in current directory"
            echo "=== END DEBUG ==="
            
            # Configure git safe directory
            git config --global --add safe.directory ${WORKSPACE}
            
            # Configure git user
            git config user.email "aaronthastal@gmail.com"
            git config user.name "Aaron White"
            
            echo "=== DEBUG: Git Config ==="
            git config --list
            echo "=== END DEBUG ==="
            
            # Check current state
            echo "=== DEBUG: Git Status Before Changes ==="
            git status
            git remote -v
            echo "=== END DEBUG ==="
            
            # Update deployment file
            echo "=== Updating deployment file ==="
            cat java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
            echo "=== After sed ==="
            cat java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
            
            # Git operations
            git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
            
            echo "=== DEBUG: Git Status After Add ==="
            git status
            echo "=== END DEBUG ==="
            
            git commit -m "Update deployment image to version ${BUILD_NUMBER}"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
          '''
        }
      }
    }
  }

  post {
    success {
      echo 'Pipeline completed successfully!'
    }
    failure {
      echo 'Pipeline failed. Check logs for details.'
    }
    always {
      cleanWs()
    }
  }
}
